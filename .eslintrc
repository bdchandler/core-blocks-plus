{
	"extends": [
		"plugin:@wordpress/eslint-plugin/recommended-with-formatting"
	],
	"env": {
		"browser": true
	},
	"settings": {
		"import/core-modules": [
			"@wordpress/block-editor",
			"@wordpress/blocks",
			"@wordpress/components",
			"@wordpress/compose",
			"@wordpress/core-data",
			"@wordpress/data",
			"@wordpress/dom-ready",
			"@wordpress/editor",
			"@wordpress/element",
			"@wordpress/hooks",
			"@wordpress/i18n",
			"@wordpress/plugins",
			"@wordpress/rich-text",
			"@wordpress/server-side-render",
			"@wordpress/url"
		]
	}
}
